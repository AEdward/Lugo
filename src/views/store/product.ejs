<section class="section" style="padding-top:56px; padding-bottom:24px;">
  <div class="container">
    <div class="grid grid-2" style="align-items:start; margin-bottom:40px;">
      <img src="<%= fabric.imageUrl %>" alt="<%= fabric.name %>" style="border-radius:6px;">
      <div>
        <span class="eyebrow"><%= fabric.material %></span>
        <h1><%= fabric.name %></h1>
        <p style="color:var(--color-ink-soft);"><%= fabric.description %></p>
        <strong style="font-size:1.3rem; color:var(--color-accent-dark);">From ETB <%= (fabric.priceCents / 100).toLocaleString() %></strong>
        <% if (outOfStock) { %>
          <p style="margin-top:12px;"><span class="badge badge-rejected">Out of Stock</span></p>
        <% } %>
      </div>
    </div>

    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <% errors.slice(0,3).forEach(function(e) { %><div><%= e.msg %></div><% }) %>
      </div>
    <% } %>

    <% if (outOfStock) { %>
      <div class="panel" style="text-align:center; max-width:520px;">
        <p style="color:var(--color-ink-soft); margin-bottom:16px;">This fabric is currently out of stock. Check back soon, or browse other fabrics.</p>
        <a class="btn btn-outline" href="/store">Browse the Store</a>
      </div>
    <% } else { %>
    <form method="POST" action="/store/fabrics/<%= fabric.id %>/add-to-cart" id="configureForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="configurator-layout">
        <div>
          <h3>Design Details</h3>
          <p class="hint" style="margin-bottom:20px;">Tap an image to choose — no need to know the technical names.</p>

          <% Object.keys(optionGroups).forEach(function(category) { %>
            <div class="option-category">
              <div class="option-category-header">
                <label class="option-category-label"><%= category %> <span class="option-category-count">(<%= optionGroups[category].length %>)</span></label>
                <% if (optionGroups[category].length > 4) { %>
                  <div class="option-scroll-nav">
                    <button type="button" class="option-scroll-btn" data-scroll-dir="-1" aria-label="Scroll <%= category %> left">&#8249;</button>
                    <button type="button" class="option-scroll-btn" data-scroll-dir="1" aria-label="Scroll <%= category %> right">&#8250;</button>
                  </div>
                <% } %>
              </div>
              <div class="option-scroll">
                <% optionGroups[category].forEach(function(opt, idx) { %>
                  <label class="option-card">
                    <input
                      type="radio"
                      name="optionIds[<%= category %>]"
                      value="<%= opt.id %>"
                      data-category="<%= category %>"
                      data-name="<%= opt.name %>"
                      data-price="<%= opt.priceCents %>"
                      data-image="<%= opt.imageUrl || '' %>"
                      <%= idx === 0 ? 'checked' : '' %>>
                    <span class="option-card-thumb">
                      <% if (opt.imageUrl) { %>
                        <img src="<%= opt.imageUrl %>" alt="<%= opt.name %>">
                      <% } else { %>
                        <span class="option-card-thumb-placeholder"><%= opt.name.charAt(0) %></span>
                      <% } %>
                    </span>
                    <span class="option-card-name"><%= opt.name %></span>
                    <span class="option-card-price"><%= opt.priceCents > 0 ? ('+ETB ' + (opt.priceCents/100).toLocaleString()) : 'Included' %></span>
                  </label>
                <% }) %>
              </div>
            </div>
          <% }) %>

          <h3 style="margin-top:40px;">Your Measurements <span style="font-weight:400;font-size:0.8rem;color:var(--color-ink-soft);">(cm / kg)</span></h3>
          <div class="form-grid">
            <% measurementFields.forEach(function(f) { %>
              <div class="field">
                <label for="m_<%= f %>"><%= f.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase()) %></label>
                <input type="number" step="0.1" min="1" id="m_<%= f %>" name="measurements[<%= f %>]" value="<%= values.measurements ? values.measurements[f] || '' : '' %>" required>
              </div>
            <% }) %>
          </div>
          <div class="field">
            <label for="notes">Notes for our tailors (optional)</label>
            <textarea id="notes" name="notes"><%= values.notes || '' %></textarea>
          </div>
        </div>

        <aside class="build-summary" id="buildSummary">
          <h3>Your Suit</h3>
          <div class="build-summary-fabric">
            <img src="<%= fabric.imageUrl %>" alt="<%= fabric.name %>">
            <div>
              <strong><%= fabric.name %></strong>
              <span><%= fabric.material %></span>
            </div>
          </div>
          <ul class="build-summary-options" id="buildSummaryOptions"></ul>
          <div class="summary-row total">
            <span>Total</span>
            <span id="buildSummaryTotal">ETB <%= (fabric.priceCents/100).toLocaleString() %></span>
          </div>
          <button class="btn btn-primary btn-block" type="submit">Add to Cart</button>
        </aside>
      </div>
    </form>
    <% } %>
  </div>
</section>

<% if (!outOfStock) { %>
<script>
  window.__fabricPriceCents = <%- fabric.priceCents %>;
</script>
<script src="/js/configurator.js"></script>
<% } %>
