<section class="page-header">
  <div class="container">
    <span class="eyebrow">Your Selections</span>
    <h1>Cart</h1>
  </div>
</section>

<section class="section" style="padding-top:24px;">
  <div class="container">
    <% if (items && items.length) { %>
      <div class="grid grid-2" style="align-items:start;">
        <div>
          <% items.forEach(function(item) { %>
            <div class="cart-item">
              <img src="<%= item.fabric.imageUrl %>" alt="<%= item.fabric.name %>">
              <div>
                <h3 style="margin-bottom:4px;"><%= item.fabric.name %></h3>
                <p style="font-size:0.85rem; color:var(--color-ink-soft); margin-bottom:6px;">
                  <% item.selectedOptions.forEach(function(o, i) { %><%= o.name %><%= i < item.selectedOptions.length - 1 ? ', ' : '' %><% }) %>
                </p>
                <p style="font-size:0.8rem; color:var(--color-ink-soft);">
                  Chest <%= item.measurements.chest %> · Waist <%= item.measurements.waist %> · Height <%= item.measurements.height %>
                </p>
              </div>
              <div style="text-align:right;">
                <strong>ETB <%= (item.lineTotalCents/100).toLocaleString() %></strong>
                <form method="POST" action="/cart/remove/<%= item.id %>" style="margin-top:8px;">
                  <button class="link-btn" type="submit">Remove</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="cart-summary">
          <div class="summary-row"><span>Subtotal</span><span>ETB <%= (subtotalCents/100).toLocaleString() %></span></div>
          <div class="summary-row total"><span>Total</span><span>ETB <%= (totalCents/100).toLocaleString() %></span></div>
          <a class="btn btn-primary btn-block" href="/checkout" style="margin-top:16px;">Proceed to Checkout</a>
          <a class="btn btn-outline btn-block" href="/store" style="margin-top:10px;">Add Another Item</a>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>Your cart is empty.</p>
        <a class="btn btn-primary" href="/store">Browse Fabrics</a>
      </div>
    <% } %>
  </div>
</section>
