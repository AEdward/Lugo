<section class="page-header">
  <div class="container">
    <span class="eyebrow">Almost There</span>
    <h1>Checkout</h1>
  </div>
</section>

<section class="section" style="padding-top:24px;">
  <div class="container grid grid-2" style="align-items:start;">
    <div class="form-card">
      <% if (errors && errors.length) { %>
        <div class="alert alert-error"><%= errors[0].msg %></div>
      <% } %>
      <form method="POST" action="/checkout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="customerName">Full Name</label>
          <input type="text" id="customerName" name="customerName" value="<%= values.customerName || '' %>" required>
        </div>
        <div class="form-grid">
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= values.email || '' %>" required>
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" required>
          </div>
        </div>
        <div class="field">
          <label>Payment Method</label>
          <div style="display:flex; flex-direction:column; gap:10px; margin-top:6px;">
            <label style="display:flex; align-items:center; gap:8px; font-weight:400;">
              <input type="radio" name="paymentMethod" value="chapa" onchange="document.getElementById('bankInfo').style.display='none';document.getElementById('cashInfo').style.display='none';" <%= (!values.paymentMethod || values.paymentMethod === 'chapa') ? 'checked' : '' %>>
              Pay Online (Chapa) — card, mobile money
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-weight:400;">
              <input type="radio" name="paymentMethod" value="bank_transfer" onchange="document.getElementById('bankInfo').style.display='block';document.getElementById('cashInfo').style.display='none';" <%= values.paymentMethod === 'bank_transfer' ? 'checked' : '' %>>
              Bank Transfer — upload your receipt after ordering
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-weight:400;">
              <input type="radio" name="paymentMethod" value="cash" onchange="document.getElementById('bankInfo').style.display='none';document.getElementById('cashInfo').style.display='block';" <%= values.paymentMethod === 'cash' ? 'checked' : '' %>>
              Cash — pay in person
            </label>
          </div>
        </div>

        <div id="bankInfo" class="alert alert-info" style="display:<%= values.paymentMethod === 'bank_transfer' ? 'block' : 'none' %>; margin-bottom:16px; white-space:pre-line;"><%= bankTransferDetails || 'Bank transfer details will be shown after you place your order.' %></div>
        <div id="cashInfo" class="alert alert-info" style="display:<%= values.paymentMethod === 'cash' ? 'block' : 'none' %>; margin-bottom:16px;"><%= cashPaymentInstructions %></div>

        <p class="hint" style="margin-bottom:20px;">Choosing Chapa redirects you to complete payment securely online. Cash and Bank Transfer orders are confirmed once we've verified your payment.</p>
        <button class="btn btn-primary btn-block" type="submit">Continue</button>
      </form>
    </div>

    <div class="cart-summary">
      <h3>Order Summary</h3>
      <% items.forEach(function(item) { %>
        <div class="build-summary-fabric" style="margin-bottom:10px;">
          <img src="<%= item.fabric.imageUrl %>" alt="<%= item.fabric.name %>">
          <div>
            <strong><%= item.fabric.name %></strong>
            <span>ETB <%= (item.lineTotalCents/100).toLocaleString() %></span>
          </div>
        </div>
        <div class="cart-item-options" style="margin-bottom:16px;">
          <% item.selectedOptions.forEach(function(o) { %>
            <span class="cart-item-option" title="<%= o.name %>">
              <% if (o.imageUrl) { %>
                <img src="<%= o.imageUrl %>" alt="<%= o.name %>">
              <% } else { %>
                <span class="option-card-thumb-placeholder"><%= o.name.charAt(0) %></span>
              <% } %>
            </span>
          <% }) %>
        </div>
      <% }) %>
      <div class="summary-row total"><span>Total</span><span>ETB <%= (totalCents/100).toLocaleString() %></span></div>
    </div>
  </div>
</section>
