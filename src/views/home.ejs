<section class="hero">
  <% if (typeof heroVideoUrl !== 'undefined' && heroVideoUrl) { %>
    <video class="hero-bg" src="<%= heroVideoUrl %>" autoplay muted loop playsinline poster="/images/hero.png"></video>
  <% } else { %>
    <img class="hero-bg" src="/images/hero.png" alt="">
  <% } %>
  <div class="hero-overlay">
    <span class="eyebrow" style="color:#e0b9b0;"><%= (content && content.eyebrow) || 'Bespoke · Handcrafted · Made to Measure' %></span>
    <h1><%= (content && content.heading) || 'Luxury tailoring, cut precisely to you.' %></h1>
    <p class="lead"><%= (content && content.intro) || 'Lugo Tailoring crafts custom suits from the finest fabrics — fitted in-studio or configured entirely online, with every measurement and detail chosen by you.' %></p>
    <div class="hero-actions">
      <a class="btn btn-accent" href="/booking">Book a Fitting</a>
      <a class="btn btn-outline" style="border-color:white;color:white;" href="/store">Design Your Suit</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header center">
      <span class="eyebrow">Two Ways to Work With Us</span>
      <h2>Choose Your Path</h2>
    </div>
    <div class="grid grid-2">
      <div class="card">
        <div class="card-body" style="text-align:center; padding:36px 28px;">
          <span class="eyebrow">In-Studio &amp; By Appointment</span>
          <h3 style="margin:8px 0 12px;">Bespoke</h3>
          <p style="color:var(--color-ink-soft); margin-bottom:20px;">A suit built entirely from scratch by a single tailor, refined across multiple in-person fittings. The full Lugo Tailoring experience.</p>
          <a class="btn btn-outline" href="/bespoke">Explore Bespoke</a>
        </div>
      </div>
      <div class="card">
        <div class="card-body" style="text-align:center; padding:36px 28px;">
          <span class="eyebrow">Configure Online</span>
          <h3 style="margin:8px 0 12px;">Made-to-Measure</h3>
          <p style="color:var(--color-ink-soft); margin-bottom:20px;">Pick your fabric and details visually, submit your own measurements, and pay online — no studio visit required to get started.</p>
          <a class="btn btn-outline" href="/store">Design Online</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-header center">
      <span class="eyebrow">How Made-to-Measure Works</span>
      <h2>Three Simple Steps</h2>
    </div>
    <div class="grid grid-3">
      <div class="feature">
        <div class="feature-icon">01</div>
        <h3>Choose Your Fabric</h3>
        <p>Browse a curated selection of wools, flannels, and blends sourced from renowned mills.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">02</div>
        <h3>Configure the Details</h3>
        <p>Select your lapel, fit, lining, and finishing touches — then submit your exact measurements.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">03</div>
        <h3>Book Your Fitting</h3>
        <p>Reserve a time with our tailors for a consultation, fitting, or final delivery.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container grid grid-2" style="align-items:center;">
    <div>
      <span class="eyebrow">Craftsmanship</span>
      <h2>Every stitch happens in our workshop.</h2>
      <p style="color:var(--color-ink-soft);">From fabric sourcing to the final press, every Lugo garment is cut, sewn, and finished in-house — never outsourced. Buttonholes and linings are hand-finished by the same tailors who cut your pattern.</p>
      <a class="btn btn-outline" href="/bespoke">See the Bespoke Process</a>
    </div>
    <img src="/images/about-atelier.png" alt="Lugo Tailoring workshop" style="border-radius:6px;">
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-header center">
      <span class="eyebrow">From the Atelier</span>
      <h2>Recent Work</h2>
    </div>
    <div class="gallery-grid">
      <% (featured || []).forEach(function(img) { %>
        <div class="gallery-item">
          <img src="<%= img.imageUrl %>" alt="<%= img.title || 'Lugo Tailoring' %>">
          <div class="gallery-caption"><%= img.title %></div>
        </div>
      <% }) %>
    </div>
    <div style="text-align:center; margin-top:36px;">
      <a class="btn btn-outline" href="/gallery">View Full Gallery</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="text-align:center;">
    <span class="eyebrow">Ready When You Are</span>
    <h2>Start your custom suit today</h2>
    <p style="max-width:520px;margin:0 auto 28px;color:var(--color-ink-soft);">Whether you know exactly what you want or need guidance from our tailors, we'll help you build something that fits perfectly.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a class="btn btn-primary" href="/store">Browse Fabrics</a>
      <a class="btn btn-outline" href="/contact">Talk to Us</a>
    </div>
  </div>
</section>
