<header class="site-header">
  <nav class="nav">
    <a class="brand" href="/">
      <img src="/images/logo.png" alt="Lugo Tailoring">
      Lugo Tailoring
    </a>

    <button class="nav-toggle" type="button" aria-label="Toggle menu" onclick="document.getElementById('navLinks').classList.toggle('open')">☰</button>

    <ul class="nav-links" id="navLinks">
      <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
      <li><a href="/bespoke" class="<%= currentPath === '/bespoke' ? 'active' : '' %>">Bespoke</a></li>
      <li><a href="/store" class="<%= currentPath && currentPath.startsWith('/store') ? 'active' : '' %>">Made-to-Measure</a></li>
      <li><a href="/gallery" class="<%= currentPath === '/gallery' ? 'active' : '' %>">Collections</a></li>
      <li><a href="/booking" class="<%= currentPath === '/booking' ? 'active' : '' %>">Booking</a></li>
      <li class="nav-dropdown">
        <button class="dropdown-toggle icon-toggle" type="button" aria-expanded="false" aria-label="Contact us">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </button>
        <div class="dropdown-menu">
          <% if (siteSettings.whatsappNumber) { %>
            <a class="dropdown-icon-link" href="https://wa.me/<%= siteSettings.whatsappNumber.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.484 1.34 5.003l-1.425 5.198 5.32-1.396a9.955 9.955 0 0 0 4.762 1.212h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.671-1.04-5.182-2.929-7.071a9.933 9.933 0 0 0-7.072-2.946zm5.8 15.797a8.29 8.29 0 0 1-5.803 2.343 8.267 8.267 0 0 1-4.206-1.15l-.302-.18-3.157.828.842-3.077-.196-.316a8.264 8.264 0 0 1-1.264-4.407c0-4.591 3.737-8.328 8.33-8.328a8.28 8.28 0 0 1 5.892 2.442 8.272 8.272 0 0 1 2.435 5.888 8.303 8.303 0 0 1-2.57 5.957z"/></svg>
              WhatsApp
            </a>
          <% } %>
          <% if (siteSettings.telegramUsername) { %>
            <a class="dropdown-icon-link" href="https://t.me/<%= siteSettings.telegramUsername.replace(/^@/, '') %>" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M21.5 3.5 2.75 10.9c-1.15.46-1.14 1.1-.2 1.38l4.5 1.4 1.72 5.3c.2.6.5.83.94.83.34 0 .5-.16.7-.35l1.9-1.85 4 2.95c.73.4 1.25.2 1.44-.68l2.6-12.24c.28-1.07-.4-1.55-1.1-1.19z"/></svg>
              Telegram
            </a>
          <% } %>
          <button type="button" class="dropdown-icon-link" data-open-contact-modal>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
            Send a Message
          </button>
        </div>
      </li>
      <li class="nav-cart">
        <a href="/cart">Cart<% if (typeof cartCount !== 'undefined' && cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %></a>
      </li>
      <% if (typeof currentCustomer !== 'undefined' && currentCustomer) { %>
        <li class="nav-dropdown">
          <button class="dropdown-toggle icon-toggle" type="button" aria-expanded="false" aria-label="Notifications">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %><span class="badge badge-rejected nav-icon-badge"><%= unreadNotifications %></span><% } %>
          </button>
          <div class="dropdown-menu dropdown-menu-wide">
            <% if (typeof recentNotifications !== 'undefined' && recentNotifications.length) { %>
              <% recentNotifications.forEach(function(n) { %>
                <a class="dropdown-notification <%= n.readAt ? '' : 'unread' %>" href="/account/notifications#notif-<%= n.id %>">
                  <strong><%= n.title %></strong>
                  <span><%= new Date(n.createdAt).toLocaleDateString() %></span>
                </a>
              <% }) %>
            <% } else { %>
              <div class="dropdown-empty">No notifications yet.</div>
            <% } %>
            <a class="dropdown-viewall" href="/account/notifications">View All Notifications</a>
          </div>
        </li>
        <li class="nav-dropdown">
          <button class="dropdown-toggle icon-toggle" type="button" aria-expanded="false" aria-label="<%= currentCustomer.name %>'s account">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </button>
          <div class="dropdown-menu">
            <a href="/account" class="<%= currentPath === '/account' ? 'active' : '' %>">Profile</a>
            <a href="/account/bookings" class="<%= currentPath === '/account/bookings' ? 'active' : '' %>">My Bookings</a>
            <a href="/account/orders" class="<%= currentPath === '/account/orders' ? 'active' : '' %>">My Orders</a>
            <a href="/account/settings" class="<%= currentPath === '/account/settings' ? 'active' : '' %>">Settings</a>
            <form method="POST" action="/account/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="dropdown-logout" type="submit">Log Out</button>
            </form>
          </div>
        </li>
      <% } else { %>
        <li><a href="/account/login" class="<%= currentPath && currentPath.startsWith('/account') ? 'active' : '' %>">Log In</a></li>
      <% } %>
    </ul>
  </nav>
</header>
