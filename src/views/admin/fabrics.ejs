<div class="admin-header">
  <div>
    <h1>Fabrics</h1>
    <p style="color:var(--color-ink-soft);">Manage the fabrics customers can choose in the Store.</p>
  </div>
</div>

<div class="panel">
  <h3 style="margin-bottom:16px;">Add Fabric</h3>
  <form method="POST" action="/admin/fabrics" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" required></div>
      <div class="field"><label for="material">Material</label><input type="text" id="material" name="material"></div>
    </div>
    <div class="form-grid">
      <div class="field"><label for="color">Color</label><input type="text" id="color" name="color"></div>
      <div class="field"><label for="price">Price (ETB)</label><input type="number" step="0.01" id="price" name="price" required></div>
    </div>
    <div class="field"><label for="description">Description</label><textarea id="description" name="description"></textarea></div>
    <div class="field"><label for="image">Swatch Image (JPG or PNG)</label><input type="file" id="image" name="image" accept="image/png,image/jpeg"></div>
    <button class="btn btn-primary" type="submit">Add Fabric</button>
  </form>
</div>

<div class="panel">
  <table class="simple">
    <thead><tr><th>Name</th><th>Material</th><th>Price</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% fabrics.forEach(function(f) { %>
        <tr>
          <td><%= f.name %></td>
          <td><%= f.material %></td>
          <td>ETB <%= (f.priceCents/100).toLocaleString() %></td>
          <td><span class="badge <%= f.inStock ? 'badge-confirmed' : 'badge-rejected' %>"><%= f.inStock ? 'In stock' : 'Hidden' %></span></td>
          <td>
            <div class="inline-actions">
              <form method="POST" action="/admin/fabrics/<%= f.id %>/toggle-stock"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline" type="submit"><%= f.inStock ? 'Hide' : 'Show' %></button></form>
              <form method="POST" action="/admin/fabrics/<%= f.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-danger" type="submit">Delete</button></form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
