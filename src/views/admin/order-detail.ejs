<div class="admin-header">
  <div>
    <h1>Order <%= order.orderNumber %></h1>
    <p style="color:var(--color-ink-soft);">Placed <%= new Date(order.createdAt).toLocaleString() %></p>
  </div>
  <a class="btn btn-outline btn-sm" href="/admin/orders">&larr; Back to Orders</a>
</div>

<div class="grid grid-2" style="align-items:start;">
  <div class="panel">
    <h3>Customer</h3>
    <p><%= order.customerName %><br><%= order.email %><br><%= order.phone %></p>

    <h3>Fabric &amp; Options</h3>
    <p><%= order.Fabric ? order.Fabric.name : '—' %></p>
    <ul>
      <% (order.selectedOptions || []).forEach(function(o) { %>
        <li><%= o.category %>: <%= o.name %> <% if (o.priceCents) { %>(+ETB <%= (o.priceCents/100).toLocaleString() %>)<% } %></li>
      <% }) %>
    </ul>

    <h3>Measurements (cm/kg)</h3>
    <table class="simple">
      <tbody>
        <% Object.keys(order.measurements || {}).forEach(function(k) { %>
          <tr><th style="text-transform:capitalize;"><%= k %></th><td><%= order.measurements[k] %></td></tr>
        <% }) %>
      </tbody>
    </table>

    <% if (order.notes) { %>
      <h3>Notes</h3>
      <p><%= order.notes %></p>
    <% } %>
  </div>

  <div class="panel">
    <h3>Payment</h3>
    <p>Status: <span class="badge badge-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></p>
    <p>Total: <strong>ETB <%= (order.totalCents/100).toLocaleString() %></strong></p>
    <p style="font-size:0.8rem; color:var(--color-ink-soft); word-break:break-all;">Chapa ref: <%= order.chapaTxRef || '—' %></p>

    <h3>Fulfillment Status</h3>
    <form method="POST" action="/admin/orders/<%= order.id %>/status">
      <div class="field">
        <select name="status">
          <option value="in_production" <%= order.status === 'in_production' ? 'selected' : '' %>>In Production</option>
          <option value="ready" <%= order.status === 'ready' ? 'selected' : '' %>>Ready for Pickup</option>
          <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
          <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>
      <button class="btn btn-primary btn-sm" type="submit">Update Status</button>
    </form>
  </div>
</div>
