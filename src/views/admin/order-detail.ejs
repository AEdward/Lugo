<div class="admin-header">
  <div>
    <h1>Order <%= order.orderNumber %></h1>
    <p style="color:var(--color-ink-soft);">Placed <%= new Date(order.createdAt).toLocaleString() %></p>
  </div>
  <a class="btn btn-outline btn-sm" href="/admin/orders">&larr; Back to Orders</a>
</div>

<div class="grid grid-2" style="align-items:start;">
  <div class="panel">
    <h3>Customer</h3>
    <p><%= order.customerName %><br><%= order.email %><br><%= order.phone %></p>

    <h3>Fabric &amp; Options</h3>
    <div class="build-summary-fabric" style="margin-bottom:12px;">
      <% if (order.Fabric) { %><img src="<%= order.Fabric.imageUrl %>" alt="<%= order.Fabric.name %>"><% } %>
      <div><strong><%= order.Fabric ? order.Fabric.name : '—' %></strong></div>
    </div>
    <ul class="build-summary-options">
      <% (order.selectedOptions || []).forEach(function(o) { %>
        <li class="build-summary-option">
          <span class="build-summary-thumb">
            <% if (o.imageUrl) { %>
              <img src="<%= o.imageUrl %>" alt="<%= o.name %>">
            <% } else { %>
              <span class="option-card-thumb-placeholder"><%= o.name.charAt(0) %></span>
            <% } %>
          </span>
          <span class="build-summary-option-info">
            <span class="build-summary-option-category"><%= o.category %></span>
            <span class="build-summary-option-name"><%= o.name %></span>
          </span>
          <span class="build-summary-option-price"><%= o.priceCents ? ('+ETB ' + (o.priceCents/100).toLocaleString()) : 'Included' %></span>
        </li>
      <% }) %>
    </ul>

    <h3>Measurements (cm/kg)</h3>
    <table class="simple">
      <tbody>
        <% Object.keys(order.measurements || {}).forEach(function(k) { %>
          <tr><th style="text-transform:capitalize;"><%= k %></th><td><%= order.measurements[k] %></td></tr>
        <% }) %>
      </tbody>
    </table>

    <% if (order.notes) { %>
      <h3>Notes</h3>
      <p><%= order.notes %></p>
    <% } %>
  </div>

  <div class="panel">
    <h3>Payment</h3>
    <p>Method: <span style="text-transform:capitalize;"><%= order.paymentMethod.replace('_', ' ') %></span></p>
    <p>Status: <span class="badge badge-<%= order.paymentStatus %>"><%= order.paymentStatus %></span></p>
    <p>Total: <strong>ETB <%= (order.totalCents/100).toLocaleString() %></strong></p>
    <p style="font-size:0.8rem; color:var(--color-ink-soft); word-break:break-all;">Reference: <%= order.chapaTxRef || '—' %></p>

    <% if (order.paymentMethod === 'cash' && order.paymentStatus !== 'paid') { %>
      <form method="POST" action="/admin/orders/<%= order.id %>/mark-cash-paid" style="margin-top:12px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary btn-sm" type="submit">Mark Cash Received</button>
      </form>
    <% } %>

    <% if (order.paymentMethod === 'bank_transfer') { %>
      <h3 style="margin-top:20px;">Bank Transfer Receipt</h3>
      <p>Receipt status: <span class="badge badge-<%= order.receiptStatus === 'paid' ? 'confirmed' : (order.receiptStatus === 'unpaid' || order.receiptStatus === 'invalid_receipt' ? 'rejected' : 'expired') %>"><%= order.receiptStatus.replace('_', ' ') %></span></p>

      <% if (order.receiptUrl) { %>
        <% if (order.receiptUrl.toLowerCase().endsWith('.pdf')) { %>
          <a class="btn btn-sm btn-outline" href="<%= order.receiptUrl %>" target="_blank" rel="noopener">View Receipt (PDF)</a>
        <% } else { %>
          <a href="<%= order.receiptUrl %>" target="_blank" rel="noopener">
            <img src="<%= order.receiptUrl %>" alt="Bank transfer receipt" style="max-width:260px; border-radius:6px; border:1px solid var(--color-line); display:block; margin:8px 0;">
          </a>
        <% } %>

        <% if (order.paymentStatus !== 'paid') { %>
          <div class="inline-actions" style="margin-top:10px;">
            <form method="POST" action="/admin/orders/<%= order.id %>/receipt-status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="receiptStatus" value="paid">
              <button class="btn btn-sm btn-primary" type="submit">Mark Paid</button>
            </form>
            <form method="POST" action="/admin/orders/<%= order.id %>/receipt-status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="receiptStatus" value="unpaid">
              <button class="btn btn-sm btn-outline" type="submit">Mark Unpaid</button>
            </form>
            <form method="POST" action="/admin/orders/<%= order.id %>/receipt-status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="receiptStatus" value="invalid_receipt">
              <button class="btn btn-sm btn-danger" type="submit">No Valid Receipt</button>
            </form>
          </div>
        <% } %>
      <% } else { %>
        <p style="color:var(--color-ink-soft);">Waiting for the customer to upload a receipt.</p>
      <% } %>
    <% } %>

    <h3 style="margin-top:20px;">Fulfillment Status</h3>
    <form method="POST" action="/admin/orders/<%= order.id %>/status">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <select name="status">
          <option value="in_production" <%= order.status === 'in_production' ? 'selected' : '' %>>In Production</option>
          <option value="ready" <%= order.status === 'ready' ? 'selected' : '' %>>Ready for Pickup</option>
          <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
          <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>
      <button class="btn btn-primary btn-sm" type="submit">Update Status</button>
    </form>
  </div>
</div>
