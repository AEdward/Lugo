<div class="admin-header">
  <div>
    <h1>Settings</h1>
    <p style="color:var(--color-ink-soft);">Site identity, contact details, and social links shown across the site.</p>
  </div>
</div>

<% if (saved) { %>
  <div class="alert alert-success">Settings saved.</div>
<% } %>

<div class="panel" style="max-width:560px;">
  <form method="POST" action="/admin/settings">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <h3 style="margin-bottom:16px;">Site Identity</h3>
    <div class="field"><label for="siteName">Site Name</label><input type="text" id="siteName" name="siteName" value="<%= values.siteName %>" required></div>

    <h3 style="margin:24px 0 16px;">Contact Details</h3>
    <div class="field"><label for="contactEmail">Contact Email</label><input type="email" id="contactEmail" name="contactEmail" value="<%= values.contactEmail %>"></div>
    <div class="field"><label for="contactPhone">Contact Phone</label><input type="text" id="contactPhone" name="contactPhone" value="<%= values.contactPhone %>"></div>
    <div class="field"><label for="contactAddress">Address</label><input type="text" id="contactAddress" name="contactAddress" value="<%= values.contactAddress %>"></div>

    <h3 style="margin:24px 0 16px;">Social Links</h3>
    <div class="field"><label for="socialFacebook">Facebook URL</label><input type="url" id="socialFacebook" name="socialFacebook" value="<%= values.socialFacebook %>" placeholder="https://facebook.com/..."></div>
    <div class="field"><label for="socialInstagram">Instagram URL</label><input type="url" id="socialInstagram" name="socialInstagram" value="<%= values.socialInstagram %>" placeholder="https://instagram.com/..."></div>
    <div class="field"><label for="socialTiktok">TikTok URL</label><input type="url" id="socialTiktok" name="socialTiktok" value="<%= values.socialTiktok %>" placeholder="https://tiktok.com/@..."></div>

    <h3 style="margin:24px 0 16px;">Alternative Checkout Payments</h3>
    <p style="color:var(--color-ink-soft); font-size:0.85rem; margin-bottom:12px;">Shown to customers who choose Cash or Bank Transfer at checkout, alongside the default Chapa online payment.</p>
    <div class="field">
      <label for="bankTransferDetails">Bank Transfer Details</label>
      <textarea id="bankTransferDetails" name="bankTransferDetails" placeholder="Bank name, account name, account number, branch..."><%= values.bankTransferDetails %></textarea>
    </div>
    <div class="field">
      <label for="cashPaymentInstructions">Cash Payment Instructions</label>
      <textarea id="cashPaymentInstructions" name="cashPaymentInstructions"><%= values.cashPaymentInstructions %></textarea>
    </div>

    <h3 style="margin:24px 0 16px;">Membership Tiers</h3>
    <p style="color:var(--color-ink-soft); font-size:0.85rem; margin-bottom:12px;">Minimum number of <strong>paid</strong> orders a customer needs to reach each tier. Shown on their profile and in Clients.</p>
    <div class="form-grid" style="grid-template-columns: repeat(3, 1fr);">
      <div class="field"><label for="tier1Min">Tier 1 — orders needed</label><input type="number" min="0" step="1" id="tier1Min" name="tier1Min" value="<%= values.tier1Min %>" required></div>
      <div class="field"><label for="tier2Min">Tier 2 — orders needed</label><input type="number" min="0" step="1" id="tier2Min" name="tier2Min" value="<%= values.tier2Min %>" required></div>
      <div class="field"><label for="tier3Min">Tier 3 — orders needed</label><input type="number" min="0" step="1" id="tier3Min" name="tier3Min" value="<%= values.tier3Min %>" required></div>
    </div>

    <button class="btn btn-primary" type="submit">Save Settings</button>
  </form>
</div>
