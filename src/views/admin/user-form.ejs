<div class="admin-header">
  <div>
    <h1><%= user ? 'Edit User' : 'Add User' %></h1>
  </div>
  <a class="btn btn-outline" href="/admin/users">Back to Users</a>
</div>

<% if (errors && errors.length) { %>
  <div class="alert alert-error">
    <% errors.forEach(function(e) { %><p><%= e.msg %></p><% }) %>
  </div>
<% } %>

<div class="panel" style="max-width:480px;">
  <form method="POST" action="<%= user ? ('/admin/users/' + user.id + '/edit') : '/admin/users' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" value="<%= values.name || '' %>" required></div>
    <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" value="<%= values.email || '' %>" required></div>
    <div class="field">
      <label for="role">Role</label>
      <select id="role" name="role" required>
        <option value="staff" <%= values.role === 'staff' ? 'selected' : '' %>>Staff</option>
        <option value="admin" <%= values.role === 'admin' || !values.role ? 'selected' : '' %>>Admin</option>
      </select>
    </div>
    <div class="field">
      <label for="password"><%= user ? 'New Password (leave blank to keep current)' : 'Password' %></label>
      <input type="password" id="password" name="password" <%= user ? '' : 'required' %> minlength="8">
    </div>
    <button class="btn btn-primary" type="submit"><%= user ? 'Save Changes' : 'Add User' %></button>
  </form>
</div>
