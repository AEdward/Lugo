<div class="admin-header">
  <div>
    <h1>Gallery</h1>
    <p style="color:var(--color-ink-soft);">Manage the images shown on the public Gallery page.</p>
  </div>
</div>

<div class="panel">
  <h3 style="margin-bottom:16px;">Upload New Image</h3>
  <form method="POST" action="/admin/gallery" enctype="multipart/form-data" class="form-grid" style="align-items:end;">
    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title">
    </div>
    <div class="field">
      <label for="category">Category</label>
      <input type="text" id="category" name="category" placeholder="Suits, Formal, Weddings...">
    </div>
    <div class="field">
      <label for="image">Image</label>
      <input type="file" id="image" name="image" accept="image/*" required>
    </div>
    <button class="btn btn-primary" type="submit" style="height:44px;">Upload</button>
  </form>
</div>

<div class="grid grid-3">
  <% images.forEach(function(img) { %>
    <div class="card">
      <img src="<%= img.imageUrl %>" alt="<%= img.title %>">
      <div class="card-body">
        <strong><%= img.title || 'Untitled' %></strong>
        <p style="color:var(--color-ink-soft); font-size:0.85rem;"><%= img.category || '—' %></p>
        <form method="POST" action="/admin/gallery/<%= img.id %>/delete">
          <button class="btn btn-sm btn-danger" type="submit">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>
