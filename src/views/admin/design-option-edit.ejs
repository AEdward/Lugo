<div class="admin-header">
  <div>
    <h1>Edit Design Option</h1>
    <p style="color:var(--color-ink-soft);">Update this option's details.</p>
  </div>
  <a class="btn btn-outline" href="/admin/design-options">Back to Design Options</a>
</div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="panel">
  <% if (option.imageUrl) { %>
    <img src="<%= option.imageUrl %>" alt="<%= option.name %>" style="width:80px;height:80px;object-fit:contain;background:var(--color-bg-alt);border-radius:6px;border:1px solid var(--color-line);margin-bottom:20px;display:block;">
  <% } %>
  <form method="POST" action="/admin/design-options/<%= option.id %>/edit" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field">
        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="lapel" <%= option.category === 'lapel' ? 'selected' : '' %>>Lapel</option>
          <option value="buttons" <%= option.category === 'buttons' ? 'selected' : '' %>>Buttons</option>
          <option value="lining" <%= option.category === 'lining' ? 'selected' : '' %>>Lining</option>
          <option value="fit" <%= option.category === 'fit' ? 'selected' : '' %>>Fit</option>
          <option value="monogram" <%= option.category === 'monogram' ? 'selected' : '' %>>Monogram</option>
          <option value="pocket" <%= option.category === 'pocket' ? 'selected' : '' %>>Pocket</option>
        </select>
      </div>
      <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" value="<%= option.name %>" required></div>
    </div>
    <div class="form-grid">
      <div class="field"><label for="price">Additional Price (ETB)</label><input type="number" step="0.01" id="price" name="price" value="<%= (option.priceCents/100).toFixed(2) %>"></div>
      <div class="field"><label for="description">Description</label><input type="text" id="description" name="description" value="<%= option.description || '' %>"></div>
    </div>
    <div class="field"><label for="image">Replace Image (JPG or PNG)</label><input type="file" id="image" name="image" accept="image/png,image/jpeg"></div>
    <button class="btn btn-primary" type="submit">Save Changes</button>
  </form>
</div>
