<div class="admin-header">
  <div>
    <h1>Design Options</h1>
    <p style="color:var(--color-ink-soft);">Lapel, buttons, lining, fit, monogram &amp; pocket choices offered in the Store. Add an image for each so customers can recognize it visually instead of by name.</p>
  </div>
</div>

<div class="panel">
  <h3 style="margin-bottom:16px;">Add Option</h3>
  <form method="POST" action="/admin/design-options" enctype="multipart/form-data">
    <div class="form-grid">
      <div class="field">
        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="lapel">Lapel</option>
          <option value="buttons">Buttons</option>
          <option value="lining">Lining</option>
          <option value="fit">Fit</option>
          <option value="monogram">Monogram</option>
          <option value="pocket">Pocket</option>
        </select>
      </div>
      <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" required></div>
    </div>
    <div class="form-grid">
      <div class="field"><label for="price">Additional Price (ETB)</label><input type="number" step="0.01" id="price" name="price" value="0"></div>
      <div class="field"><label for="description">Description</label><input type="text" id="description" name="description"></div>
    </div>
    <div class="field"><label for="image">Image (JPG or PNG)</label><input type="file" id="image" name="image" accept="image/png,image/jpeg"></div>
    <button class="btn btn-primary" type="submit">Add Option</button>
  </form>
</div>

<div class="panel">
  <table class="simple">
    <thead><tr><th>Image</th><th>Category</th><th>Name</th><th>Price</th><th></th></tr></thead>
    <tbody>
      <% options.forEach(function(o) { %>
        <tr>
          <td>
            <% if (o.imageUrl) { %>
              <img src="<%= o.imageUrl %>" alt="<%= o.name %>" style="width:56px;height:56px;object-fit:contain;background:var(--color-bg-alt);border-radius:4px;border:1px solid var(--color-line);">
            <% } else { %>
              <span style="color:var(--color-ink-soft); font-size:0.8rem;">No image</span>
            <% } %>
          </td>
          <td style="text-transform:capitalize;"><%= o.category %></td>
          <td><%= o.name %></td>
          <td><%= o.priceCents > 0 ? ('+ETB ' + (o.priceCents/100).toLocaleString()) : 'Included' %></td>
          <td>
            <form method="POST" action="/admin/design-options/<%= o.id %>/delete"><button class="btn btn-sm btn-danger" type="submit">Delete</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
