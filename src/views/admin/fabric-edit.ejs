<div class="admin-header">
  <div>
    <h1>Edit Fabric</h1>
    <p style="color:var(--color-ink-soft);">Update the details customers see in the Store.</p>
  </div>
  <a class="btn btn-outline" href="/admin/fabrics">Back to Fabrics</a>
</div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="panel">
  <% if (fabric.imageUrl) { %>
    <img src="<%= fabric.imageUrl %>" alt="<%= fabric.name %>" style="width:120px;height:120px;object-fit:cover;border-radius:6px;border:1px solid var(--color-line);margin-bottom:20px;display:block;">
  <% } %>
  <form method="POST" action="/admin/fabrics/<%= fabric.id %>/edit" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" value="<%= fabric.name %>" required></div>
      <div class="field"><label for="material">Material</label><input type="text" id="material" name="material" value="<%= fabric.material || '' %>"></div>
    </div>
    <div class="form-grid">
      <div class="field"><label for="color">Color</label><input type="text" id="color" name="color" value="<%= fabric.color || '' %>"></div>
      <div class="field"><label for="price">Price (ETB)</label><input type="number" step="0.01" id="price" name="price" value="<%= (fabric.priceCents/100).toFixed(2) %>" required></div>
    </div>
    <div class="field"><label for="description">Description</label><textarea id="description" name="description"><%= fabric.description || '' %></textarea></div>
    <div class="field">
      <label for="stockQuantity">Stock Quantity (leave blank for unlimited / made-to-order)</label>
      <input type="number" step="1" min="0" id="stockQuantity" name="stockQuantity" value="<%= fabric.stockQuantity === null ? '' : fabric.stockQuantity %>">
    </div>
    <div class="field"><label for="image">Replace Swatch Image (JPG or PNG)</label><input type="file" id="image" name="image" accept="image/png,image/jpeg"></div>
    <button class="btn btn-primary" type="submit">Save Changes</button>
  </form>
</div>
