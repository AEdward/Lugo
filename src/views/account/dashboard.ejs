<section class="page-header">
  <span class="eyebrow">My Account</span>
  <h1>Welcome back, <%= currentCustomer.name %></h1>
</section>

<section class="section" style="padding-top:24px;">
  <div class="container">
    <%- include('../partials/account-nav') %>

    <div class="panel" style="margin-bottom:24px;">
      <h3 style="margin-bottom:12px;">Profile</h3>
      <div class="grid grid-2">
        <p style="color:var(--color-ink-soft); margin:0;"><strong style="color:var(--color-ink);">Email</strong><br><%= currentCustomer.email %></p>
        <p style="color:var(--color-ink-soft); margin:0;"><strong style="color:var(--color-ink);">Phone</strong><br><%= currentCustomer.phone || 'Not provided' %></p>
      </div>
      <p style="color:var(--color-ink-soft); margin:14px 0 0;">Member since <%= new Date(memberSince).toLocaleDateString([], { year: 'numeric', month: 'long' }) %></p>
      <a class="btn btn-outline btn-sm" href="/account/settings" style="margin-top:14px;">Edit Profile</a>
    </div>

    <div class="grid grid-2">
      <div class="panel">
        <h3 style="margin-bottom:12px;">Upcoming Appointment</h3>
        <% if (upcomingBooking) { %>
          <p style="margin-bottom:4px; text-transform:capitalize;"><strong><%= upcomingBooking.serviceType %></strong></p>
          <p style="color:var(--color-ink-soft);"><%= new Date(upcomingBooking.startsAt).toLocaleString([], {dateStyle:'medium', timeStyle:'short'}) %></p>
        <% } else { %>
          <p style="color:var(--color-ink-soft); margin-bottom:16px;">No upcoming confirmed appointments.</p>
          <a class="btn btn-outline btn-sm" href="/booking">Book a Fitting</a>
        <% } %>
      </div>

      <div class="panel">
        <h3 style="margin-bottom:12px;">Most Recent Order</h3>
        <% if (recentOrder) { %>
          <p style="margin-bottom:4px;"><strong><%= recentOrder.orderNumber %></strong><% if (recentOrder.Fabric) { %> — <%= recentOrder.Fabric.name %><% } %></p>
          <p style="color:var(--color-ink-soft);">Status: <span class="badge badge-<%= recentOrder.paymentStatus %>"><%= recentOrder.status %></span></p>
        <% } else { %>
          <p style="color:var(--color-ink-soft); margin-bottom:16px;">No orders yet.</p>
          <a class="btn btn-outline btn-sm" href="/store">Design Your Suit</a>
        <% } %>
      </div>
    </div>
  </div>
</section>
