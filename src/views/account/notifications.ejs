<section class="page-header">
  <span class="eyebrow">My Account</span>
  <h1>Notifications</h1>
</section>

<section class="section" style="padding-top:24px;">
  <div class="container">
    <%- include('../partials/account-nav') %>

    <% if (items.some(function(n) { return !n.readAt; })) { %>
      <form method="POST" action="/account/notifications/read-all" style="margin-bottom:16px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-outline btn-sm" type="submit">Mark All Read</button>
      </form>
    <% } %>

    <div class="panel">
      <% if (items.length === 0) { %>
        <div class="empty-state">
          <p>No notifications yet.</p>
        </div>
      <% } else { %>
        <table class="simple">
          <thead><tr><th></th><th>Notification</th><th>When</th><th></th></tr></thead>
          <tbody>
            <% items.forEach(function(n) { %>
              <tr style="<%= n.readAt ? '' : 'font-weight:600;' %>">
                <td><% if (!n.readAt) { %><span class="badge badge-rejected">New</span><% } %></td>
                <td>
                  <% if (n.link) { %><a href="<%= n.link %>"><%= n.title %></a><% } else { %><%= n.title %><% } %>
                  <% if (n.body) { %><div style="font-weight:400; color:var(--color-ink-soft); font-size:0.85rem;"><%= n.body %></div><% } %>
                </td>
                <td style="font-weight:400; color:var(--color-ink-soft); white-space:nowrap;"><%= new Date(n.createdAt).toLocaleString([], {dateStyle:'medium', timeStyle:'short'}) %></td>
                <td>
                  <% if (!n.readAt) { %>
                    <form method="POST" action="/account/notifications/<%= n.id %>/read">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline" type="submit">Mark Read</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</section>
