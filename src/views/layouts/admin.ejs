<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — Lugo Admin' : 'Lugo Admin' %></title>
  <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <a class="admin-brand" href="/admin">
          <img src="/images/logo.svg" alt="Lugo Tailoring">
          Lugo Admin
        </a>
        <nav class="admin-nav">
          <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">Dashboard</a>
          <a href="/admin/bookings" class="<%= currentPath.startsWith('/admin/bookings') ? 'active' : '' %>">Bookings</a>
          <a href="/admin/orders" class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>">Orders</a>
          <a href="/admin/fabrics" class="<%= currentPath.startsWith('/admin/fabrics') ? 'active' : '' %>">Fabrics</a>
          <a href="/admin/design-options" class="<%= currentPath.startsWith('/admin/design-options') ? 'active' : '' %>">Design Options</a>
          <a href="/admin/gallery" class="<%= currentPath.startsWith('/admin/gallery') ? 'active' : '' %>">Gallery</a>
          <a href="/admin/messages" class="<%= currentPath.startsWith('/admin/messages') ? 'active' : '' %>">Messages</a>
        </nav>
        <div class="admin-sidebar-footer">
          <a href="/" target="_blank">View Site ↗</a>
          <form method="POST" action="/admin/logout">
            <button class="link-btn" type="submit">Log Out</button>
          </form>
        </div>
      </aside>
      <main class="admin-main">
        <%- body %>
      </main>
    </div>
  <% } else { %>
    <%- body %>
  <% } %>
</body>
</html>
