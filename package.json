  "description": "Lugo Tailoring — custom luxury suit tailoring website (booking, custom fabric/design orders, admin dashboard)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
