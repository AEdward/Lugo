    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "multer": "^2.0.1",
    "mysql2": "^3.12.0",
    "node-cron": "^3.0.3",
