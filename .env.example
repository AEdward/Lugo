# App
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lugo_tailoring
DB_USER=lugo_app
DB_PASSWORD=change-me

# Seeded admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@lugotailoring.com
ADMIN_PASSWORD=change-this-password

# Chapa payments (https://developer.chapa.co)
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_BASE_URL=https://api.chapa.co/v1

# Booking rules
BOOKING_HOLD_HOURS=24
BOOKING_SLOT_MINUTES=60
BOOKING_OPEN_HOUR=10
BOOKING_CLOSE_HOUR=18
BOOKING_CLOSED_WEEKDAYS=0,1
